  {
    "location": "html-block:64",
    "text": "Feeder Management Relays",
    "heading": "MiCOM P14x"
  },
  {
    "location": "html-block:65",
    "text": "Part of PowerLogic™",
    "heading": "MiCOM P14x"
  },
  {
    "location": "html-block:66",
    "text": "Overcurrent, Earth Fault and complete feeder power system protection, control and monitoring including advanced communication and integrated functions dedicated to feeders. Models available: MiCOM P141, MiCOM P142, MiCOM P143, MiCOM P145",
    "heading": "MiCOM P14x"
  },
