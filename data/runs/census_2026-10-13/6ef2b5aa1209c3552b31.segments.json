  {
    "location": "html-block:65",
    "text": "Part of PowerLogic™",
    "heading": "MiCOM P841"
  },
  {
    "location": "html-block:66",
    "text": "Easergy MiCOM P841 is a multifunctional line terminal IED for control and back-up protection in transmission and sub-transmission feeder bays. Models available: MiCOM P841",
    "heading": "MiCOM P841"
  },
