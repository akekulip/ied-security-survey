    "text": "PowerLogic ION7550 RTU"
  },
  {
    "location": "html-block:64",
    "text": "Remote terminal unit for data acquisition and integrated utilities metering",
    "heading": "PowerLogic ION7550 RTU"
  },
  {
    "location": "html-block:65",
    "text": "Part of PowerLogic™",
    "heading": "PowerLogic ION7550 RTU"
  },
  {
    "location": "html-block:66",
    "text": "Intelligent, web-enabled device provides a cost-effective, dedicated WAGES solution and helps to improve energy efficiency.",
    "heading": "PowerLogic ION7550 RTU"
  },
