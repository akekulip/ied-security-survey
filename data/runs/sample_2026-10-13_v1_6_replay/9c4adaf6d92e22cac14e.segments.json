    "location": "html-block:34",
    "text": "Overview",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:35",
    "text": "Our Bulletin 1426 PowerMonitor™ 5000 is the next generation of high-end, power-quality metering products. Building on core power and energy metering capabilities, the PowerMonitor 5000 takes energy monitoring to the next level.",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:36",
    "text": "Monitors 4 voltage and 4 current channels for every electrical cycle — 1024 data points across 8 channels every 12-17 milliseconds",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:37",
    "text": "Calculates over 6,000 parameters every cycle",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:38",
    "text": "Provides a second communication port",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:39",
    "text": "Includes native EtherNet/IP™ port",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:40",
    "text": "Includes 4 digital inputs for WAGES data collection",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:41",
    "text": "Includes 4 outputs for connection to SCADA or control systems",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:42",
    "text": "Offers configurable alarms for up to 20 events",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:43",
    "text": "Provides virtual wiring correction capability",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:44",
    "text": "PowerMonitor 5000 Models",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:45",
    "text": "M5 — base model",
    "heading": "Allen-Bradley"
  },
  {
