    "location": "html-block:34",
    "text": "Overview",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:35",
    "text": "Our Bulletin 1420 PowerMonitor™ 500 features an on-device LCD display in a compact footprint giving you instant visibility into your energy use. A cost-effective sub-metering option, our monitor provides critical data to help you make at-process decisions, reduce energy use, and increase your company's profits.",
    "heading": "Allen-Bradley"
  },
  {
    "location": "html-block:36",
    "text": "Overview"
  },
  {
    "location": "html-block:37",
    "text": "Offers compact size and panel mounted",
    "heading": "Overview"
  },
  {
    "location": "html-block:38",
    "text": "Includes built-in LCD display allows you to record data centrally and display it locally",
    "heading": "Overview"
  },
  {
    "location": "html-block:39",
    "text": "Measures voltage, current, power, energy, demand, and power factor",
    "heading": "Overview"
  },
  {
    "location": "html-block:40",
    "text": "Includes multiple communication protocols, including Modbus RTU and EtherNet/IP™",
    "heading": "Overview"
  },
  {
    "location": "html-block:41",
    "text": "Offers 2 digital relay outputs (optional)",
    "heading": "Overview"
  },
  {
    "location": "html-block:42",
    "text": "Offers 2 analog (4-20mA) outputs (optional) for variable speed process control",
    "heading": "Overview"
  },
  {
    "location": "html-block:43",
    "text": "Includes 4 configurable alarms",
    "heading": "Overview"
  },
  {
    "location": "html-block:44",
    "text": "Provides full integration with RSEnergyMetrix® asset management software for a complete energy management solution",
    "heading": "Overview"
  },
