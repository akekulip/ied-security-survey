  {
    "location": "html-block:76",
    "text": "Features"
  },
  {
    "location": "html-block:77",
    "text": "Remote and Advanced displays available",
    "heading": "Features"
  },
  {
    "location": "html-block:78",
    "text": "Digital I/O: 0-10 Inputs/4-8 Outputs",
    "heading": "Features"
  },
  {
    "location": "html-block:79",
    "text": "Analog Outputs: 1 Output",
    "heading": "Features"
  },
  {
    "location": "html-block:80",
    "text": "Two Modbus communication ports",
    "heading": "Features"
  },
  {
    "location": "html-block:81",
    "text": "0-8 temperature sensor inputs",
    "heading": "Features"
  },
  {
    "location": "html-block:82",
    "text": "LPCT: low-power current transducer complying with standard IEC 60044-8",
    "heading": "Features"
  },
  {
    "location": "html-block:83",
    "text": "Removable memory cartridge with parameters and settings for quick commissioning after replacement",
    "heading": "Features"
  },
  {
    "location": "html-block:84",
    "text": "Built-in logic matrix and equation editor",
    "heading": "Features"
  },
  {
    "location": "html-block:85",
    "text": "Contractual warranty",
    "heading": "Features"
  },
  {
    "location": "html-block:86",
    "text": "Period : 2 years",
    "heading": "Features"
  },
  {
    "location": "html-block:87",
    "text": "Benefits"
  },
  {
    "location": "html-block:88",
    "text": "Compact case provides standardized dimensions",
    "heading": "Benefits"
  },
  {
    "location": "html-block:89",
    "text": "Setting software with Boolean logic equation assistance allows for improved control scheme design",
    "heading": "Benefits"
  },
  {
    "location": "html-block:90",
    "text": "Built-in CT/VT and trip circuit supervision reduces design time",
    "heading": "Benefits"
  },
  {
    "location": "html-block:91",
    "text": "16 s of fault recording, multiple captures, history of last 5 trip reports, and 200 time-tagged alarms provides for improved fault analysis and reduced restoration time",
    "heading": "Benefits"
  },
  {
    "location": "html-block:92",
    "text": "16 RTD inputs allows for greater flexibility temperature measurement applications",
    "heading": "Benefits"
  },
