    const pathParts = window.location.pathname.replace(/^\/+/, '').split('/');

    // Look for 'hardware' and ensure it's the second-to-last part
    const hardwareIndex = pathParts.indexOf('products') !== -1 
        ? pathParts.indexOf('hardware')
