<div><div class="section-heading mb-4 container text-start" data-ste-element="Sites: Section Heading"><div><div class="row text-start"><div class="col col-md-8"><h2 class="header-focus"><span>Key benefits</span></h2></div></div></div></div><div class="container three-column-tile"><div class="row"><div data-ste-element="teaser" data-ste-teaser-type="tile" data-ste-teaser-title="Comprehensive protection and monitoring" class="col-12 col-sm-12 col-md-6 col-lg-4 tileHeightAdjust"><div class="tile-flex-wrapper"><h3 class="strong tileHeading">Comprehensive protection and monitoring</h3><div class="tileDescription"><p>Provides overcurrent and earth fault protection for high- and low-voltage systems, integrating control, measurement, and monitoring in a single compact device to ensure reliable and efficient power distribution.</p></div></div></div><div data-ste-element="teaser" data-ste-teaser-type="tile" data-ste-teaser-title="Easy installation and configuration" class="col-12 col-sm-12 col-md-6 col-lg-4 tileHeightAdjust"><div class="tile-flex-wrapper"><h3 class="strong tileHeading">Easy installation and configuration</h3><div class="tileDescription"><p>Compact design with quick fit spring wire terminations, front USB for configuration, and a free mobile app for Bluetooth connectivity simplify setup, reduce installation time, and minimize resource use.</p></div></div></div><div data-ste-element="teaser" data-ste-teaser-type="tile" data-ste-teaser-title="Effortless data management and access" class="col-12 col-sm-12 col-md-6 col-lg-4 tileHeightAdjust"><div class="tile-flex-wrapper"><h3 class="strong tileHeading">Effortless data management and access</h3><div class="tileDescription"><p>Download and view fault and waveform records on mobile devices, manage data files in multiple languages, and support SCADA communication for seamless integration and operational transparency.</p></div></div></div></div></div></div></div><div id='1unaj0DvaimRGCXZSENUTK' class='sitesCardsContainer themed-component-wrapper' data-ste-section='cards-container_4' data-ste-section-id='1unaj0DvaimRGCXZSENUTK'><is-land on:visible><div id="comp-1unaj0DvaimRGCXZSENUTK" class="CardsContainer" data-component-type="CardsContainer"><section id="1unaj0DvaimRGCXZSENUTK" class="cards-defaultBackground" role="region" aria-labelledby="section-heading-1unaj0DvaimRGCXZSENUTK"><div class="section-heading mb-4 container text-start" data-ste-element="Sites: Section Heading"><div><div class="row text-start"><div class="col col-md-8"><h2 class="header-focus"><span>Featured capabilities</span></h2></div></div></div></div><div class="container"><div class="row cards-container-row"><div class="siemens-cards col-md-4"><div data-ste-element="teaser" data-ste-teaser-type="card" data-ste-teaser-title="Bluetooth-enabled mobile app configuration" id="G_Bluetooth-enabled%20mobile%20app%20configuration-0" class="card blogWrapNoLink rounded-0" role="article" aria-labelledby="G_Bluetooth-enabled%20mobile%20app%20configuration-0-title" aria-describedby="G_Bluetooth-enabled%20mobile%20app%20configuration-0-desc" tabindex="0"><div class="imageWrapper"></div><div class="card-body d-flex flex-column p-3"><strong class="text-kicker pb-2 mb-0 text-color"></strong><div class="category d-none">all</div><h3 id="G_Bluetooth-enabled%20mobile%20app%20configuration-0-title" class="pb-4 mb-0">Bluetooth-enabled mobile app configuration</h3><div id="G_Bluetooth-enabled%20mobile%20app%20configuration-0-desc" class="text-black card-text pb-3 mb-0"><div><p>The free mobile app allows secure Bluetooth pairing for device configuration, data management, and record downloads, supporting multiple languages and enabling quick, confident setup from any mobile device.</p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div><div class="siemens-cards col-md-4"><div data-ste-element="teaser" data-ste-teaser-type="card" data-ste-teaser-title="Integrated SCADA communication protocols" id="G_Integrated%20SCADA%20communication%20protocols-1" class="card blogWrapNoLink rounded-0" role="article" aria-labelledby="G_Integrated%20SCADA%20communication%20protocols-1-title" aria-describedby="G_Integrated%20SCADA%20communication%20protocols-1-desc" tabindex="0"><div class="imageWrapper"></div><div class="card-body d-flex flex-column p-3"><strong class="text-kicker pb-2 mb-0 text-color"></strong><div class="category d-none">all</div><h3 id="G_Integrated%20SCADA%20communication%20protocols-1-title" class="pb-4 mb-0">Integrated SCADA communication protocols</h3><div id="G_Integrated%20SCADA%20communication%20protocols-1-desc" class="text-black card-text pb-3 mb-0"><div><p>Supports serial RS485 communication with IEC60870-5-103 and MODBUS protocols, enabling seamless integration into existing SCADA systems for real-time monitoring and control of power distribution assets.</p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div><div class="siemens-cards col-md-4"><div data-ste-element="teaser" data-ste-teaser-type="card" data-ste-teaser-title="Front USB for power and data retrieval" id="G_Front%20USB%20for%20power%20and%20data%20retrieval-2" class="card blogWrapNoLink rounded-0" role="article" aria-labelledby="G_Front%20USB%20for%20power%20and%20data%20retrieval-2-title" aria-describedby="G_Front%20USB%20for%20power%20and%20data%20retrieval-2-desc" tabindex="0"><div class="imageWrapper"></div><div class="card-body d-flex flex-column p-3"><strong class="text-kicker pb-2 mb-0 text-color"></strong><div class="category d-none">all</div><h3 id="G_Front%20USB%20for%20power%20and%20data%20retrieval-2-title" class="pb-4 mb-0">Front USB for power and data retrieval</h3><div id="G_Front%20USB%20for%20power%20and%20data%20retrieval-2-desc" class="text-black card-text pb-3 mb-0"><div><p>The front USB port powers the device during configuration and enables fast, direct data retrieval, streamlining maintenance and reducing downtime for engineers and operators.</p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div></div></div></section><template data-island><script type="module" src="/shared-assets/1f5459c4589ce8f899743c2f1031e839981f40d9/lib/helpers/esm/index.module.js"></script><disw-hydrate component="CardsContainer" props-url="/props/1unaj0DvaimRGCXZSENUTK-en-US.json" page-id="1VOFDrvHiywmVrN4EILH2K" container="comp-1unaj0DvaimRGCXZSENUTK"></disw-hydrate></template></div></is-land></div><div id='5t6r2l3o4BlveUNuLMITlL' class='sitesThreeColTiles themed-component-wrapper' data-ste-section='three-col-tiles_5' data-ste-section-id='5t6r2l3o4BlveUNuLMITlL'>
