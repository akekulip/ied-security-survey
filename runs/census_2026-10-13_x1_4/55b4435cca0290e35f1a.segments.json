  {
    "location": "html-block:66",
    "text": "Easergy MiCOM P746 numerical busbar protection provides centralized complete protection for all voltages level up to extra high voltage busbar configurations. Models available: MiCOM P746",
    "heading": "MiCOM P746"
  },
