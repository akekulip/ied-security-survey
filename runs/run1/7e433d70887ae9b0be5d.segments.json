[
  {
    "location": "html-block:1",
    "text": "SSA-750499"
  },
  {
    "location": "html-block:2",
    "text": "Siemens Security Advisory by Siemens ProductCERT"
  },
  {
    "location": "html-block:3",
    "text": "SSA-750499: Weak Encryption Vulnerability in SIPROTEC 5 Devices"
  },
  {
    "location": "html-block:4",
    "text": "Publication Date: |"
  },
  {
    "location": "html-block:5",
    "text": "2024-07-09"
  },
  {
    "location": "html-block:6",
    "text": "Last Update: |"
  },
  {
    "location": "html-block:7",
    "text": "2025-11-11"
  },
  {
    "location": "html-block:8",
    "text": "Current Version: | V1.2"
  },
  {
    "location": "html-block:9",
    "text": "CVSS v3.1 Base Score: | 5.9"
  },
  {
    "location": "html-block:10",
    "text": "CVSS v4.0 Base Score: | 8.2"
  },
  {
    "location": "html-block:11",
    "text": "SUMMARY"
  },
  {
    "location": "html-block:12",
    "text": "The SIPROTEC 5 devices are supporting weak encryption. This could allow an unauthorized attacker in a man-in-the-middle position to read any data passed over the connection between legitimate clients and the affected device."
  },
  {
    "location": "html-block:13",
    "text": "Siemens has released new versions for several affected products and recommends to update to the latest versions. Siemens recommends specific countermeasures for products where fixes are not, or not yet available."
  },
  {
    "location": "html-block:14",
    "text": "KNOWN AFFECTED PRODUCTS Un-/Collapse All"
  },
  {
    "location": "html-block:15",
    "text": "Affected Product and Versions | Remediation"
  },
  {
