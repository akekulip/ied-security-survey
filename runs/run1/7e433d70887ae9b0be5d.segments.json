  },
  {
    "location": "html-block:409",
    "text": "See further recommendations from section Workarounds and Mitigations"
  },
  {
    "location": "html-block:410",
    "text": "SIPROTEC 5 Communication Module ETH-BD-2FO"
  },
  {
    "location": "html-block:411",
