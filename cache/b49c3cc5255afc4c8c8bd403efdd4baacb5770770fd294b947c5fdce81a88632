ageWrapper"></div><div class="card-body d-flex flex-column p-3"><strong class="text-kicker pb-2 mb-0 text-color"></strong><div class="category d-none">all</div><h3 id="G_Diverse%20applications-1-title" class="pb-4 mb-0">Diverse applications</h3><div id="G_Diverse%20applications-1-desc" class="text-black card-text pb-3 mb-0"><div><p>Apply to busbars, connections, transformers, reactors and motors. Use in high impedance applications with stabilizing and non-linear resistors.  </p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div><div class="siemens-cards col-md-4"><div data-ste-element="teaser" data-ste-teaser-type="card" data-ste-teaser-title="Accurate Time stamping" id="G_Accurate%20Time%20stamping%20-2" class="card blogWrapNoLink rounded-0" role="article" aria-labelledby="G_Accurate%20Time%20stamping%20-2-title" aria-describedby="G_Accurate%20Time%20stamping%20-2-desc" tabindex="0"><div class="imageWrapper"></div><div class="card-body d-flex flex-column p-3"><strong class="text-kicker pb-2 mb-0 text-color"></strong><div class="category d-none">all</div><h3 id="G_Accurate%20Time%20stamping%20-2-title" class="pb-4 mb-0">Accurate Time stamping </h3><div id="G_Accurate%20Time%20stamping%20-2-desc" class="text-black card-text pb-3 mb-0"><div><p>Maintain accurate event recording and system coordination with optional IRIG-B or Ethernet SNTP time synchronisation. </p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div></div></div></section><template data-island><script type="module" src="/shared-assets/1f5459c4589ce8f899743c2f1031e839981f40d9/lib/helpers/esm/index.module.js"></script><disw-hydrate component="CardsContainer" props-url="/props/7L2C1s207tvU6wkd5CIw82-en-US.json" page-id="4IrKbPWKwsGehU2VVX2ng" container="comp-7L2C1s207tvU6wkd5CIw82"></disw-hydrate></template></div></is-land></div><div id='66zcK4AvaeBvJjaAYcSc5L' cla