-text pb-3 mb-0"><div><p>Integrate Ethernet RJ45 for DIGSI 5 and IEC 61850 communication. Add up to 4 pluggable modules for redundant protocols like Modbus TCP and PROFINET IO.</p></div></div><div data-area="card-info-section" class="d-flex flex-column justify-content-end h-100"></div></div></div></div></div></div></section><template data-island><script type="module" src="/shared-assets/1f5459c4589ce8f899743c2f1031e839981f40d9/lib/helpers/esm/index.module.js"></script><disw-hydrate component="CardsContainer" props-url="/props/1WPAYeAbG07T91RZTBqDBy-en-US.json" page-id="1TMvVSgBZukG9ZPngl2b6a" container="comp-1WPAYeAbG07T91RZTBqDBy"></disw-hydrate></template></div></is-land></div><div id='1o3VIiE5YKhoBMVahBMhqy' class='sitesThreeColTiles themed-component-wrapper' data-ste-section='three-col-tiles_4' data-ste-section-id='1o3VIiE5YKhoBMVahBMhqy'>
