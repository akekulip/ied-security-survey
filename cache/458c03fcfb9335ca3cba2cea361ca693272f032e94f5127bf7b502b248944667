        document.querySelectorAll('.product-family-list__product-title').forEach((titleEl, index) => {
            const orderStr = String(index + 1).padStart(4, '0');
            const hiddenSpan = document.createElement('span');
            hiddenSpan.className = 'hidden';
            hiddenSpan.textContent = orderStr;
            titleEl.prepend(hiddenSpan);
        });
